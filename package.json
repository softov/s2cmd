{
  "name": "s2cmd",
  "version": "0.1.0",
  "description": "Command lines, HTTP routes and MCP tools from YAML or JSON documents, powered by facio.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "s2cmd": "./dist/s2cmd.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "samples",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "check": "npm run build && npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "facio": "file:../facio"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
