{
  "name": "s2cmd",
  "version": "0.1.0",
  "description": "Command lines, HTTP routes and MCP tools from one YAML or JSON document",
  "keywords": [
    "cli",
    "command-line",
    "cli-generator",
    "yaml",
    "json",
    "declarative",
    "task-runner",
    "scripts",
    "mcp",
    "model-context-protocol",
    "agent",
    "http",
    "rest",
    "api-client",
    "openapi",
    "cofold"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/softov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/s2cmd.git"
  },
  "homepage": "https://github.com/softov/s2cmd#readme",
  "bugs": {
    "url": "https://github.com/softov/s2cmd/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "s2cmd": "dist/s2cmd.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "samples",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && npm run typecheck && npm test",
    "dev": "tsx src/s2cmd.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@cofold/commands": "^0.3.0",
    "@cofold/config": "^0.3.1",
    "@cofold/mcp": "^0.3.0",
    "@cofold/remote": "^0.5.0",
    "@cofold/sdk": "^0.2.0",
    "@cofold/terminal": "^0.5.1",
    "@cofold/yaml": "^0.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
